#!/usr/bin/env bash
set -euo pipefail

printf "%-10s %-6s %-28s %s\n" "NODE" "STATE" "MODEL" "URL"
printf "%-10s %-6s %-28s %s\n" "----------" "------" "----------------------------" "-------------------------"

for entry in \
  "z8|http://100.64.0.2:11434" \
  "v100-1|http://100.64.0.7:11434" \
  "v100-2|http://100.64.0.6:11434"
do
  IFS='|' read -r NODE URL <<< "$entry"

  JSON="$(curl -s --max-time 5 "$URL/api/tags" 2>/dev/null || true)"

  if [ -z "$JSON" ]; then
    printf "%-10s %-6s %-28s %s\n" "$NODE" "DOWN" "-" "$URL"
    continue
  fi

  COUNT="$(printf '%s' "$JSON" | jq '.models | length' 2>/dev/null || echo 0)"

  if [ "$COUNT" -eq 0 ]; then
    printf "%-10s %-6s %-28s %s\n" "$NODE" "UP" "(no models)" "$URL"
    continue
  fi

  FIRST=1
  while IFS= read -r MODEL; do
    if [ "$FIRST" -eq 1 ]; then
      printf "%-10s %-6s %-28s %s\n" "$NODE" "UP" "$MODEL" "$URL"
      FIRST=0
    else
      printf "%-10s %-6s %-28s %s\n" "" "" "$MODEL" ""
    fi
  done < <(printf '%s' "$JSON" | jq -r '.models[].name')
done
